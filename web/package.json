{
  "name": "alphaos-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --experimental-strip-types ./tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "check:workers": "node scripts/check-worker-output.mjs",
    "deploy:workers": "cf deploy --prebuilt",
    "upload:workers": "cf workers versions create --prebuilt",
    "cf-typegen": "cf workers types",
    "preview:workers": "cf previews deploy",
    "test:workers": "node --test tests/workers/*.test.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.447.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.16.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "autoprefixer": "^10.4.20",
    "cf": "1.0.0-beta.23",
    "miniflare": "5.20261023.0-beta",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vinext": "1.3.1",
    "vite": "8.3.5"
  },
  "type": "module",
  "imports": {
    "#alphaos-runtime": "./src/lib/runtime-node.ts"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "fflate": "0.8.3",
    "postcss-selector-parser": "6.1.5"
  }
}
