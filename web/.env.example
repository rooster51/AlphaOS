ALPHAOS_API_URL=http://localhost:8000
ALPHAOS_API_TOKEN=

# Supabase (Public client values for eventual auth integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
