# Server-rendered Next.js web service (Node.js 22; not a static export).
# Configure these in the hosting provider's server-side environment.
# ALPHAOS_API_TOKEN is a secret: never prefix it with NEXT_PUBLIC_.
ALPHAOS_API_URL=http://localhost:8000
ALPHAOS_API_TOKEN=
ALPHAOS_DEMO_MODE=false

# Supabase client values are unused by the current read-only web foundation.
# Leave unset until the corresponding authenticated integration is implemented.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
