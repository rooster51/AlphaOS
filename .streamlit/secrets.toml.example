# Copy this file to Streamlit Community Cloud secrets, not to .streamlit/secrets.toml in Git.
# Streamlit Cloud: App settings -> Secrets

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-key"

# Public.com server-side credential. Never commit a real value.
PUBLIC_API_SECRET = "your-public-secret-key"
# Only this verified AlphaOS login can view the connected portfolio.
PUBLIC_OWNER_EMAIL = "your-login-email@example.com"
# Optional when your key can access multiple Public accounts.
# PUBLIC_ACCOUNT_NUMBER = "your-public-account-number"

# Alpaca market data for 30-minute Pulse backtesting. Use paper account keys if preferred.
ALPACA_API_KEY_ID = "your-alpaca-key-id"
ALPACA_API_SECRET_KEY = "your-alpaca-secret-key"
